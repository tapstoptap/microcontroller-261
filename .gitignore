# Local STM32CubeIDE workspace state and generated builds
**/.metadata/
**/Debug/
**/Release/

# Proteus automatic backups and per-user workspace state
*.pdsbak
*.pdsprj.*.workspace

# Lab 2 schematic previews are kept as PNG; retain BMP originals locally.
/Proteus_Project/Lab2/*.bmp

# LaTeX build output and local visual-QA renders
**/*.aux
**/*.fdb_latexmk
**/*.fls
**/*.lof
**/*.log
**/*.lol
**/*.lot
**/*.out
**/*.synctex.gz
**/*.toc
**/_*.data.minted
**/_qa/
**/page_previews/

# Unused example material bundled with the report template
reports/**/chapters/example/
reports/**/code/example.py
reports/**/refs/example.bib

# Unpacked copies of Proteus projects (the .pdsprj is the source of truth)
**/extracted/

# Lab reports are kept local only (not published)
/reports/

# STM32CubeIDE files regenerated from each .ioc - only the .ioc and
# hand-written sources (main.c and custom modules) are committed
/workspace_1.7.0/**/Drivers/
/workspace_1.7.0/**/.settings/
/workspace_1.7.0/**/.cproject
/workspace_1.7.0/**/.mxproject
/workspace_1.7.0/**/.project
/workspace_1.7.0/**/*.ld
/workspace_1.7.0/**/Core/Startup/
/workspace_1.7.0/**/Core/Inc/main.h
/workspace_1.7.0/**/Core/Inc/stm32f1xx_*.h
/workspace_1.7.0/**/Core/Src/stm32f1xx_*.c
/workspace_1.7.0/**/Core/Src/syscalls.c
/workspace_1.7.0/**/Core/Src/sysmem.c
/workspace_1.7.0/**/Core/Src/system_stm32f1xx.c
